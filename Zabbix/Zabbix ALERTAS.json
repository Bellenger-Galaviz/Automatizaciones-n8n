    {
      "parameters": {
        "jsCode": "// Este código itera sobre los elementos y crea una cadena de texto formateada\nfor (const item of $input.all()) {\n  const body = item.json.body;\n  \n  // Construcción del mensaje con saltos de línea\n  let messageText = \"⚠️ ALERTA DE ZABBIX ⚠️\\n\";\n  messageText += `Equipo: ${body.equipo || 'N/A'}\\n`;\n  messageText += `Evento: ${body.evento || 'N/A'}\\n`;\n  messageText += `Severidad: ${body.severidad || 'N/A'}\\n`;\n  messageText += `Detalle: ${JSON.stringify(body)}`; // Incluye el resto por si acaso\n\n  item.json.formattedMessage = messageText;\n}\n\nreturn $input.all();"
      },
