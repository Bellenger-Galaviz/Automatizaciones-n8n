      "parameters": {
        "jsCode": "for (const item of items) {\n  // Asegúrate de que el objeto 'json' existe y tiene la propiedad 'statusCode'\n  if (item.json && item.json.statusCode !== undefined) {\n    const statusCode = item.json.statusCode;\n\n    // Crea el booleano 'exitoso': TRUE si statusCode es 200 o 204.\n    // FALSE en cualquier otro caso.\n    if (statusCode === 200 || statusCode === 204) {\n      item.json.exitoso = true;\n    } else {\n      item.json.exitoso = false;\n    }\n  } else {\n    // Manejo de caso donde no hay statusCode (ej. error de conexión previo)\n    item.json.exitoso = false;\n    item.json.errorInfo = 'StatusCode no encontrado en el elemento.';\n  }\n}\n\nreturn items;"
      },
